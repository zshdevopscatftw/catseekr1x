class CatSeekModel:
    def __init__(self, config_name: str = "CatSeek R1 7B"):
        self.config_name = config_name
        cfg = MODEL_CONFIGS.get(config_name, MODEL_CONFIGS["CatSeek R1 7B"])
        
        self.dim = cfg["dim"]
        self.n_layers = cfg["n_layers"]
        self.n_heads = cfg["n_heads"]
        self.n_experts = cfg["n_experts"]
        self.description = cfg["description"]
        self.size = cfg["size"]
        self.params_str = cfg["params"]
        
        self.tokenizer = CatSeekTokenizer()
        self.vocab_size = self.tokenizer.vocab_size
        
        # Build model
        self.embedding = np.random.randn(self.vocab_size, self.dim).astype(np.float32) * 0.02
        self.layers = [TransformerBlock(self.dim, self.n_heads, use_moe=(i % 2 == 1)) 
                       for i in range(self.n_layers)]
        self.norm = RMSNorm(self.dim)
        self.output = np.random.randn(self.dim, self.vocab_size).astype(np.float32) * 0.02
        
        self.param_count = self._count_params()
        self._init_weights()
        
        # Knowledge base
        self.knowledge = self._build_knowledge()
    
    def _count_params(self) -> int:
        total = self.embedding.size + self.output.size + self.norm.weight.size
        for layer in self.layers:
            total += layer.attn.W_q.size + layer.attn.W_k.size + layer.attn.W_v.size + layer.attn.W_o.size
            if hasattr(layer.ffn, 'experts'):
                total += layer.ffn.gate.size
                for e in layer.ffn.experts:
                    total += e.W_gate.size + e.W_up.size + e.W_down.size
            else:
                total += layer.ffn.W_gate.size + layer.ffn.W_up.size + layer.ffn.W_down.size
            total += layer.norm1.weight.size + layer.norm2.weight.size
        return total
    
    def _init_weights(self):
        np.random.seed(42)
        for word, idx in self.tokenizer.word_to_id.items():
            if idx < self.vocab_size:
                emb = np.random.randn(self.dim).astype(np.float32) * 0.1
                if word in ['I', 'you', 'we', 'they']: emb[:self.dim//4] += 0.3
                elif word in ['is', 'are', 'was', 'were']: emb[self.dim//4:self.dim//2] += 0.3
                elif word in ['.', '!', '?']: emb[self.dim//2:] += 0.5
                self.embedding[idx] = emb
        np.random.seed(None)
    
    def _build_knowledge(self) -> Dict[str, List[str]]:
        return {
            'greeting': [
                f"Hello! I'm {self.config_name}, running locally on your machine. How can I help you today?",
                f"Hi there! {self.config_name} at your service. What would you like to explore?",
                "Hey! Ready to assist with coding, writing, analysis, or just chat!",
            ],
            'identity': [
                f"""I'm **{self.config_name}**, a local AI assistant.

**Model Info:**
• Architecture: DeepSeek R1 (MoE + MLA + RoPE)
• Parameters: {self.param_count:,} ({self.params_str})
• Layers: {self.n_layers} transformer blocks
• Experts: {self.n_experts} per MoE layer
• Size: {self.size}

**Capabilities:**
• 💬 Chat & conversation
• 💻 Code assistance
• 📝 Writing & editing
• 🧠 Reasoning & analysis
• 🔒 100% local & private

All processing happens on your device - your data never leaves your computer!""",
            ],
            'help': [
                f"""**{self.config_name}** - Local AI Assistant

**What I can do:**
• 💬 **Chat** - Natural conversation
• 💻 **Code** - Write, debug, explain code
• 📝 **Write** - Essays, emails, stories
• 🧠 **Reason** - Analysis & problem solving
• 🔍 **Research** - Answer questions

**Settings (in sidebar):**
• Temperature - Creativity (0.1-2.0)
• Max Length - Response length
• Top-P - Response diversity

**Privacy:** Everything runs locally!""",
            ],
            'coding': [
                """I can help with coding! Here's what I offer:

**Languages:** Python, JavaScript, TypeScript, Java, C++, Go, Rust, SQL, and more

**Tasks:**
• ✍️ Write code from descriptions
• 🐛 Debug and fix errors
• 📚 Explain code & concepts
• ⚡ Optimize performance
• 🔍 Code review

What are you working on?""",
            ],
            'thanks': [
                "You're welcome! Let me know if you need anything else.",
                "Happy to help! Feel free to ask more questions.",
                "Anytime! That's what I'm here for.",
            ],
            'goodbye': [
                "Goodbye! Your chats are saved locally. See you next time!",
                "Take care! Remember, I'm always here when you need me.",
                "Bye! Thanks for chatting!",
            ],
        }
    
    def detect_intent(self, text: str) -> Optional[str]:
        text_lower = text.lower()
        patterns = {
            'greeting': ['hello', 'hi', 'hey', 'greetings', 'good morning', 'good afternoon'],
            'identity': ['who are you', 'what are you', 'about you', 'what model', 'which model'],
            'help': ['help', 'what can you do', 'capabilities', 'features'],
            'coding': ['write code', 'help me code', 'programming', 'debug', 'python', 'javascript'],
            'thanks': ['thank', 'thanks', 'appreciate'],
            'goodbye': ['bye', 'goodbye', 'see you', 'exit'],
        }
        for intent, keywords in patterns.items():
            if any(kw in text_lower for kw in keywords):
                return intent
        return None
    
    def generate(self, prompt: str, max_tokens: int = 150, temperature: float = 0.7,
                 top_p: float = 0.9, callback=None) -> str:
        # Check knowledge base first
        intent = self.detect_intent(prompt)
        if intent and intent in self.knowledge:
            return random.choice(self.knowledge[intent])
        
        # Math handling
        match = re.search(r'(\d+(?:\.\d+)?)\s*([+\-*/^])\s*(\d+(?:\.\d+)?)', prompt)
        if match:
            a, op, b = float(match.group(1)), match.group(2), float(match.group(3))
            try:
                if op == '+': r = a + b
                elif op == '-': r = a - b
                elif op == '*': r = a * b
                elif op == '/': r = a / b if b else "undefined"
                elif op == '^': r = a ** b
                if isinstance(r, float) and r == int(r): r = int(r)
                return f"**{a} {op} {b} = {r}**"
            except: pass
        
        # Clear cache
        for layer in self.layers:
            layer.clear_cache()
        
        # Encode
        tokens = self.tokenizer.encode(prompt)
        tokens = np.array([tokens], dtype=np.int32)
        generated = list(tokens[0])
        
        # Process prompt
        if len(generated) > 1:
            x = self.embedding[tokens[:, :-1]]
            for layer in self.layers:
                x = layer.forward(x, use_cache=True)
            current = tokens[:, -1:]
        else:
            current = tokens
        
        # Generate
        for i in range(max_tokens):
            x = self.embedding[current]
            for layer in self.layers:
                x = layer.forward(x, use_cache=True)
            logits = (self.norm.forward(x) @ self.output)[0, -1] / max(temperature, 0.1)
            
            probs = np.exp(logits - logits.max())
            probs = probs / probs.sum()
            
            # Top-p
            sorted_idx = np.argsort(probs)[::-1]
            cumsum = np.cumsum(probs[sorted_idx])
            cutoff = np.searchsorted(cumsum, top_p)
            mask = np.ones(len(probs), dtype=bool)
            mask[sorted_idx[:cutoff + 1]] = False
            probs[mask] = 0
            probs = probs / max(probs.sum(), 1e-10)
            
            next_token = np.random.choice(len(probs), p=probs)
            generated.append(next_token)
            
            if callback and i % 5 == 0:
                callback(self.tokenizer.decode(generated))
            
            if next_token == self.tokenizer.eos_id:
                break
            
            current = np.array([[next_token]], dtype=np.int32)
        
        result = self.tokenizer.decode(generated)
        if result.startswith(prompt):
            result = result[len(prompt):].strip()
        
        if len(result) < 10:
            return "I'd be happy to help! Could you tell me more about what you need?"
        
        return result


