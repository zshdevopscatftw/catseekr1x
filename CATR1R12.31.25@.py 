    def _load_model(self, name: str):
        """Load a model"""
        self.status_label.config(text="Loading model...", fg=self.colors["text_muted"])
        self.update()
        
        def load():
            self.model = CatSeekModel(name)
            self.after(0, lambda: self._on_model_loaded(name))
        
        threading.Thread(target=load, daemon=True).start()
    
    def _on_model_loaded(self, name: str):
        """Called when model is loaded"""
        self.current_model_name = name
        self.db.set_setting("model", name)
        
        cfg = MODEL_CONFIGS[name]
        self.model_info.config(text=f"{cfg['description']}\n{cfg['size']} • {cfg['params']}")
        
        self.status_label.config(text=f"✓ {name} loaded", fg=self.colors["success"])
        
        # Welcome message
        if not self.messages:
            self.chat_area.add_message(
                f"Welcome! I'm {name}, running locally on your machine.\n\n"
                f"I can help with:\n• 💬 Chat & conversation\n• 💻 Code assistance\n"
                f"• 📝 Writing & editing\n• 🧠 Analysis & reasoning\n\n"
                f"Everything is processed locally - your data never leaves your computer!",
                is_user=False
            )
    
    def _on_model_change(self, event):
        """Handle model selection change"""
        new_model = self.model_var.get()
        if new_model != self.current_model_name:
            self._new_chat()
            self._load_model(new_model)
    
    def _on_enter(self, event):
        """Handle enter key"""
        if not (event.state & 0x1):  # Not shift
            self._send_message()
            return "break"
    
    def _send_message(self):
        """Send a message"""
        if self.generating:
            return
        
        text = self.input_text.get("1.0", "end-1c").strip()
        if not text:
            return
        
        self.input_text.delete("1.0", tk.END)
        
        # Add user message
        self.chat_area.add_message(text, is_user=True)
        self.messages.append({"role": "user", "content": text})
        
        # Update title if first message
        if len(self.messages) == 1:
            self.chat_title.config(text=text[:40] + "..." if len(text) > 40 else text)
        
        # Generate response
        self._generate_response(text)
    
    def _generate_response(self, prompt: str):
        """Generate AI response"""
        self.generating = True
        self.status_label.config(text="Generating...", fg=self.colors["accent"])
        
        def generate():
            response = self.model.generate(
                prompt,
                max_tokens=self.max_len_var.get(),
                temperature=self.temp_var.get(),
                top_p=self.top_p_var.get()
            )
            self.after(0, lambda: self._on_response(response))
        
        threading.Thread(target=generate, daemon=True).start()
    
    def _on_response(self, response: str):
        """Handle generated response"""
        self.chat_area.add_message(response, is_user=False)
        self.messages.append({"role": "assistant", "content": response})
        
        self.status_label.config(text="Ready", fg=self.colors["success"])
        self.generating = False
    
    def _new_chat(self):
        """Start a new chat"""
        if self.messages:
            title = self.messages[0]["content"][:30] if self.messages else "Chat"
            self.db.save_chat(title, self.messages, self.current_model_name)
            self._refresh_chat_list()
        
        self.messages = []
        self.chat_area.clear()
        self.chat_title.config(text="New Chat")
        
        if self.model:
            self.chat_area.add_message(
                f"Starting fresh! I'm {self.current_model_name}, ready to help.",
                is_user=False
            )
    
    def _refresh_chat_list(self):
        """Refresh chat history list"""
        self.chat_list.delete(0, tk.END)
        for chat in self.db.load_chats()[:20]:
            self.chat_list.insert(tk.END, f"💬 {chat['title'][:25]}")
    
    def _load_selected_chat(self, event):
        """Load selected chat from history"""
        sel = self.chat_list.curselection()
        if not sel:
            return
        
        chats = self.db.load_chats()
        if sel[0] < len(chats):
            data = self.db.load_chat(chats[sel[0]]['id'])
            if data:
                messages, model = data
                self.messages = messages
                self.chat_area.clear()
                
                for msg in messages:
                    self.chat_area.add_message(msg['content'], msg['role'] == 'user')
                
                if messages:
                    self.chat_title.config(text=messages[0]['content'][:40])
    
    def _save_settings(self):
        """Save settings"""
        self.db.set_setting("temperature", str(self.temp_var.get()))
        self.db.set_setting("max_length", str(self.max_len_var.get()))
        self.db.set_setting("top_p", str(self.top_p_var.get()))


