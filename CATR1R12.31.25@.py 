        msg_label.pack(fill="x")
        
        # Layout based on sender
        if is_user:
            avatar_label.pack(side="right", padx=(10, 0))
            bubble.pack(side="right", fill="x", expand=False)
        else:
            avatar_label.pack(side="left", padx=(0, 10))
            bubble.pack(side="left", fill="x", expand=False)


class ScrollableChat(tk.Frame):
    """Scrollable chat container"""
    
    def __init__(self, parent, **kwargs):
        super().__init__(parent, **kwargs)
        
        self.canvas = tk.Canvas(self, bg="#1a1a2e", highlightthickness=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.scrollable_frame = tk.Frame(self.canvas, bg="#1a1a2e")
        
        self.scrollable_frame.bind("<Configure>",
            lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        
        self.canvas_frame = self.canvas.create_window((0, 0), window=self.scrollable_frame, anchor="nw")
        self.canvas.configure(yscrollcommand=self.scrollbar.set)
        
        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")
        
        self.canvas.bind('<Configure>', self._on_canvas_configure)
        self.canvas.bind_all("<MouseWheel>", self._on_mousewheel)
    
    def _on_canvas_configure(self, event):
        self.canvas.itemconfig(self.canvas_frame, width=event.width)
    
    def _on_mousewheel(self, event):
        self.canvas.yview_scroll(int(-1*(event.delta/120)), "units")
    
    def add_message(self, message: str, is_user: bool):
        bubble = ChatBubble(self.scrollable_frame, message, is_user, bg="#1a1a2e")
        bubble.pack(fill="x", pady=2)
        self.canvas.update_idletasks()
        self.canvas.yview_moveto(1.0)
    
    def clear(self):
        for widget in self.scrollable_frame.winfo_children():
            widget.destroy()


