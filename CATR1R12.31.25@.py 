    def _add_slider(self, parent, label: str, var, from_: float, to: float, resolution: float):
        """Add a labeled slider"""
        frame = tk.Frame(parent, bg=self.colors["bg_dark"])
        frame.pack(fill="x", pady=(10, 0))
        
        header = tk.Frame(frame, bg=self.colors["bg_dark"])
        header.pack(fill="x")
        
        tk.Label(header, text=label, font=("Segoe UI", 10),
                bg=self.colors["bg_dark"], fg=self.colors["text"]).pack(side="left")
        
        value_label = tk.Label(header, text=f"{var.get():.2f}" if isinstance(var.get(), float) else str(var.get()),
                              font=("Segoe UI", 10), bg=self.colors["bg_dark"], fg=self.colors["accent"])
        value_label.pack(side="right")
        
        slider = ttk.Scale(frame, from_=from_, to=to, variable=var, orient="horizontal")
        slider.pack(fill="x", pady=(5, 0))
        
        def update_label(*args):
            val = var.get()
            value_label.config(text=f"{val:.2f}" if isinstance(val, float) else str(int(val)))
            self._save_settings()
        
        var.trace_add("write", update_label)
    
