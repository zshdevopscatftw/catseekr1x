    def _try_math(self, text: str) -> Optional[str]:
        """Solve math expressions"""
        patterns = [
            r'(\d+(?:\.\d+)?)\s*([+\-*/^%])\s*(\d+(?:\.\d+)?)',
            r'what\s+is\s+(\d+(?:\.\d+)?)\s*([+\-*/^%])\s*(\d+(?:\.\d+)?)',
            r'calculate\s+(\d+(?:\.\d+)?)\s*([+\-*/^%])\s*(\d+(?:\.\d+)?)',
            r'(\d+(?:\.\d+)?)\s*(plus|minus|times|divided by|to the power of)\s*(\d+(?:\.\d+)?)',
        ]
        
        for pattern in patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                try:
                    a = float(match.group(1))
                    op_str = match.group(2).lower()
                    b = float(match.group(3))
                    
                    # Map word operators
                    op_map = {'plus': '+', 'minus': '-', 'times': '*', 'divided by': '/', 'to the power of': '^'}
                    op = op_map.get(op_str, op_str)
                    
                    # Calculate
                    ops = {'+': lambda x,y: x+y, '-': lambda x,y: x-y, '*': lambda x,y: x*y,
                           '/': lambda x,y: x/y if y else float('inf'), '^': lambda x,y: x**y,
                           '%': lambda x,y: x%y}
                    
                    result = ops.get(op, lambda x,y: None)(a, b)
                    if result is None:
                        return None
                    
                    if isinstance(result, float) and result == int(result):
                        result = int(result)
                    
                    return f"**{a} {op} {b} = {result}** 🐱"
                except:
                    pass
        
        return None
    
