# TOKENIZER WITH COHERENT VOCABULARY
# ═══════════════════════════════════════════════════════════════════════════════

class CoherentTokenizer:
    """Tokenizer optimized for coherent text generation"""
    
    def __init__(self):
        # Build vocabulary from word list
        self.vocab = []
        seen = set()
        
        for word in VOCAB_WORDS:
            if word not in seen:
                self.vocab.append(word)
                seen.add(word)
        
        # Add common programming patterns
        code_tokens = ["()", "[]", "{}", "->", "=>", "==", "!=", "<=", ">=", "+=", "-=", 
                      "*=", "/=", "**", "//", "&&", "||", "++", "--", "::", "self.", "this."]
        for t in code_tokens:
            if t not in seen:
                self.vocab.append(t)
                seen.add(t)
        
        self.token_to_id = {t: i for i, t in enumerate(self.vocab)}
        self.id_to_token = {i: t for i, t in enumerate(self.vocab)}
        
        self.pad_id = 0
        self.unk_id = 1
        self.bos_id = 2
        self.eos_id = 3
        
        # Build bigram transition matrix for coherent generation
        self._build_transitions()
    
    def _build_transitions(self):
        """Build transition probabilities for coherent generation"""
        self.transitions = defaultdict(lambda: defaultdict(float))
        
        for word, nexts in BIGRAMS.items():
            if word in self.token_to_id:
                for next_word in nexts:
                    if next_word in self.token_to_id:
                        self.transitions[self.token_to_id[word]][self.token_to_id[next_word]] = 1.0
    
    @property
    def vocab_size(self):
        return len(self.vocab)
    
    def encode(self, text: str) -> List[int]:
        """Encode text to token IDs using greedy longest match"""
        tokens = [self.bos_id]
        i = 0
        
        while i < len(text):
            matched = False
            
            # Try longest match first (up to 20 chars)
            for length in range(min(20, len(text) - i), 0, -1):
                substr = text[i:i+length]
                if substr in self.token_to_id:
                    tokens.append(self.token_to_id[substr])
                    i += length
                    matched = True
                    break
            
            if not matched:
                # Single character fallback
                char = text[i]
                if char in self.token_to_id:
                    tokens.append(self.token_to_id[char])
                else:
                    tokens.append(self.unk_id)
                i += 1
        
        return tokens
    
    def decode(self, ids: List[int]) -> str:
        """Decode token IDs to text"""
        result = []
        for id in ids:
            if id in [self.pad_id, self.bos_id, self.eos_id]:
                continue
            if id == self.unk_id:
                continue  # Skip unknown tokens
            if id in self.id_to_token:
                result.append(self.id_to_token[id])
        return ''.join(result)
    
    def get_coherent_next(self, prev_token_id: int) -> Dict[int, float]:
        """Get coherent next token probabilities based on bigrams"""
        return dict(self.transitions[prev_token_id])


