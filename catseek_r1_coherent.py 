    def _init_coherent_weights(self):
        """Initialize weights to favor coherent word sequences"""
        # Boost common starting tokens
        starters = ["I", "The", "This", "Here", "Let", "You", "We", "It", "That", "Yes", "No",
                   "First", "To", "For", "A", "An", "def", "class", "function", "if", "return"]
        for word in starters:
            if word in self.tokenizer.token_to_id:
                idx = self.tokenizer.token_to_id[word]
                self.lm_head[:, idx] += 0.3
        
        # Boost punctuation and structure
        for word in [" ", ".", ",", "\n", ":", "(", ")", "[", "]", "{", "}"]:
            if word in self.tokenizer.token_to_id:
                idx = self.tokenizer.token_to_id[word]
                self.lm_head[:, idx] += 0.2
        
        # Boost common words
        common = ["is", "are", "the", "a", "an", "to", "in", "for", "of", "and", "or", "with",
                 "can", "will", "be", "have", "has", "this", "that", "it", "you", "we", "they"]
        for word in common:
            if word in self.tokenizer.token_to_id:
                idx = self.tokenizer.token_to_id[word]
                self.lm_head[:, idx] += 0.15
        
        # Apply bigram coherence to embeddings
        for prev_id, nexts in self.tokenizer.transitions.items():
            if prev_id < self.vocab_size:
                for next_id, weight in nexts.items():
                    if next_id < self.vocab_size:
                        # Make embeddings of likely sequences more similar
                        self.embed[next_id] += self.embed[prev_id] * 0.1 * weight
    
    def _count_params(self):
        total = self.embed.size + self.lm_head.size + self.norm.w.size
        for l in self.layers:
            total += l.attn.Wq.size + l.attn.Wk.size + l.attn.Wv.size + l.attn.Wo.size
            total += l.norm1.w.size + l.norm2.w.size
            if l.use_moe:
                total += l.ffn.gate.size
                for e in l.ffn.experts: total += e.Wg.size + e.Wu.size + e.Wd.size
                total += l.ffn.shared.Wg.size + l.ffn.shared.Wu.size + l.ffn.shared.Wd.size
            else:
                total += l.ffn.Wg.size + l.ffn.Wu.size + l.ffn.Wd.size
        return total
    
    def forward(self, ids, use_cache=False):
        """Forward pass through transformer"""
        x = self.embed[ids]
        for l in self.layers:
            x = l.forward(x, use_cache)
        return self.norm.forward(x) @ self.lm_head
    
    def generate(self, prompt: str, max_tokens: int = 200, temperature: float = 0.7,
                top_p: float = 0.9, top_k: int = 50, use_cot: bool = False, **kwargs) -> str:
        """Generate coherent text response"""
        
        # Try template-based response first for better quality
        response = self.response_gen.generate(prompt, max_tokens, use_cot)
        if response:
            return response
        
        # Fall back to transformer generation with coherence boosting
        return self._transformer_generate(prompt, max_tokens, temperature, top_p, top_k, use_cot)
    
    def _transformer_generate(self, prompt: str, max_tokens: int, temperature: float,
                             top_p: float, top_k: int, use_cot: bool) -> str:
        """Generate using transformer with coherence boosting"""
        
        # Clear KV cache
        for l in self.layers:
            l.clear()
        
        # Encode prompt
        tokens = self.tokenizer.encode(prompt)
        ids = np.array([tokens], dtype=np.int32)
        generated = list(tokens)
        
        # Process prompt through transformer (fill cache)
        if len(tokens) > 1:
            _ = self.forward(ids[:, :-1], use_cache=True)
            current = ids[:, -1:]
        else:
            current = ids
        
        # Track last token for bigram coherence
        last_token = generated[-1] if generated else self.tokenizer.bos_id
        
        # Generate tokens
        output_tokens = []
        for step in range(max_tokens):
            # Get transformer logits
            logits = self.forward(current, use_cache=True)[0, -1]
            
            # Apply temperature
            logits = logits / max(temperature, 0.01)
            
            # Apply bigram coherence boost
            coherent_nexts = self.tokenizer.get_coherent_next(last_token)
            for next_id, boost in coherent_nexts.items():
                if next_id < len(logits):
                    logits[next_id] += boost * 2.0  # Strong coherence boost
            
            # Top-K filtering
            if top_k > 0:
                top_k_idx = np.argsort(logits)[-top_k:]
                mask = np.ones_like(logits, dtype=bool)
                mask[top_k_idx] = False
                logits[mask] = -1e9
            
            # Softmax
            probs = np.exp(logits - logits.max())
            probs = probs / (probs.sum() + 1e-9)
            
            # Top-P (nucleus) sampling
            sorted_idx = np.argsort(probs)[::-1]
            cumsum = np.cumsum(probs[sorted_idx])
            cutoff = np.searchsorted(cumsum, top_p)
            keep_idx = sorted_idx[:cutoff + 1]
            
            filtered = np.zeros_like(probs)
            filtered[keep_idx] = probs[keep_idx]
            filtered = filtered / (filtered.sum() + 1e-9)
            
            # Sample next token
            next_token = np.random.choice(len(filtered), p=filtered)
            
            # Check stop conditions
            if next_token == self.tokenizer.eos_id:
                break
            
            output_tokens.append(next_token)
            generated.append(next_token)
            last_token = next_token
            
            # Repetition check
            if len(output_tokens) > 10:
                recent = output_tokens[-8:]
                if len(set(recent)) <= 2:
                    break
            
            current = np.array([[next_token]], dtype=np.int32)
        
        # Decode output
        result = self.tokenizer.decode(output_tokens)
        
        # Clean up
        result = self._clean_output(result)
        
        # Add CoT wrapper if requested
        if use_cot and len(result) > 10:
            result = "<think>\nLet me think about this step by step...\n</think>\n\n" + result
        
        return result if len(result) > 5 else "I'd be happy to help! Could you tell me more? 🐱"
    
    def _clean_output(self, text: str) -> str:
        """Clean up generated text"""
        # Remove repeated spaces
        text = re.sub(r' +', ' ', text)
        # Remove repeated punctuation
        text = re.sub(r'([.!?])\1+', r'\1', text)
        # Remove repeated newlines
        text = re.sub(r'\n\n\n+', '\n\n', text)
        # Trim whitespace
        text = text.strip()
        return text


