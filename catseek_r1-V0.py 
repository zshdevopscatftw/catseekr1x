            av.pack(side="right", padx=(8, 0))
            bubble.pack(side="right")
        else:
            av.pack(side="left", padx=(0, 8))
            bubble.pack(side="left")

class ScrollableChat(tk.Frame):
    def __init__(self, parent, colors: Dict):
        super().__init__(parent, bg=colors["bg"])
        self.colors = colors
        self.canvas = tk.Canvas(self, bg=colors["bg"], highlightthickness=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.inner = tk.Frame(self.canvas, bg=colors["bg"])
        
        self.canvas_win = self.canvas.create_window((0, 0), window=self.inner, anchor="nw")
        self.inner.bind("<Configure>", lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")))
        self.canvas.configure(yscrollcommand=self.scrollbar.set)
        
        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")
        self.canvas.bind('<Configure>', lambda e: self.canvas.itemconfig(self.canvas_win, width=e.width))
        self.canvas.bind_all("<MouseWheel>", lambda e: self.canvas.yview_scroll(-e.delta//120, "units"))
    
    def add_message(self, text: str, is_user: bool):
        ChatBubble(self.inner, text, is_user, self.colors).pack(fill="x")
        self.canvas.update_idletasks()
        self.canvas.yview_moveto(1.0)
    
    def clear(self):
        for w in self.inner.winfo_children(): w.destroy()

class CatSeekApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("CatSeek R1 14B - Local AI")
        self.geometry("1150x780")
        self.minsize(900, 600)
        
        self.colors = {
            "bg": "#1e1e2e", "sidebar": "#11111b", "input_bg": "#313244",
            "user_bubble": "#585b70", "bot_bubble": "#1e1e2e",
            "accent": "#cba6f7", "accent_hover": "#b4befe",
            "text": "#cdd6f4", "text_muted": "#a6adc8", "text_dim": "#6c7086",
            "success": "#a6e3a1", "border": "#45475a",
        }
        self.configure(bg=self.colors["sidebar"])
        
        self.db = Database()
        self.messages = []
        self.generating = False
        self.model = None
        self.selected_model = self.db.get("model", DEFAULT_MODEL)
        
        self.temp_var = tk.DoubleVar(value=float(self.db.get("temp", "0.7")))
        self.max_len_var = tk.IntVar(value=int(self.db.get("max_len", "200")))
        self.top_p_var = tk.DoubleVar(value=float(self.db.get("top_p", "0.9")))
        self.cot_var = tk.BooleanVar(value=self.db.get("cot", "0") == "1")
        
        self._build_sidebar()
        self._build_main()
        self._load_model()
    
    def _build_sidebar(self):
        sb = tk.Frame(self, bg=self.colors["sidebar"], width=270)
        sb.grid(row=0, column=0, sticky="nsew")
        sb.grid_propagate(False)
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)
        
        # Logo
        logo = tk.Frame(sb, bg=self.colors["sidebar"])
        logo.pack(fill="x", pady=20, padx=15)
        tk.Label(logo, text="🐱", font=("Segoe UI Emoji", 36), bg=self.colors["sidebar"]).pack(side="left")
        tf = tk.Frame(logo, bg=self.colors["sidebar"])
        tf.pack(side="left", padx=10)
        tk.Label(tf, text="CatSeek R1", font=("Segoe UI", 20, "bold"), bg=self.colors["sidebar"], fg=self.colors["text"]).pack(anchor="w")
        tk.Label(tf, text="DeepSeek R1 Arch", font=("Segoe UI", 9), bg=self.colors["sidebar"], fg=self.colors["text_muted"]).pack(anchor="w")
        
        tk.Frame(sb, bg=self.colors["border"], height=1).pack(fill="x", padx=15, pady=10)
        
        # New chat
        tk.Button(sb, text="✨ New Chat", font=("Segoe UI", 11, "bold"), bg=self.colors["accent"], fg="#1e1e2e",
                 relief="flat", command=self._new_chat).pack(fill="x", padx=15, pady=8, ipady=8)
        
        # Model
        mf = tk.Frame(sb, bg=self.colors["sidebar"])
        mf.pack(fill="x", padx=15, pady=10)
        tk.Label(mf, text="MODEL", font=("Segoe UI", 9, "bold"), bg=self.colors["sidebar"], fg=self.colors["text_muted"]).pack(anchor="w")
        
        self.model_var = tk.StringVar(value=self.selected_model)
        ttk.Combobox(mf, textvariable=self.model_var, values=list(MODELS.keys()), state="readonly").pack(fill="x", pady=5)
        
        self.model_info = tk.Label(mf, text="Loading...", font=("Segoe UI", 9), bg=self.colors["sidebar"], fg=self.colors["text_dim"], wraplength=230)
        self.model_info.pack(anchor="w")
        self.params_label = tk.Label(mf, text="", font=("Segoe UI", 9, "bold"), bg=self.colors["sidebar"], fg=self.colors["accent"])
        self.params_label.pack(anchor="w")
        
        tk.Frame(sb, bg=self.colors["border"], height=1).pack(fill="x", padx=15, pady=10)
        
        # Settings
        sf = tk.Frame(sb, bg=self.colors["sidebar"])
        sf.pack(fill="x", padx=15)
        tk.Label(sf, text="SETTINGS", font=("Segoe UI", 9, "bold"), bg=self.colors["sidebar"], fg=self.colors["text_muted"]).pack(anchor="w")
        
        for name, var, lo, hi in [("Temperature", self.temp_var, 0.1, 2.0), ("Max Tokens", self.max_len_var, 50, 400), ("Top-P", self.top_p_var, 0.1, 1.0)]:
            f = tk.Frame(sf, bg=self.colors["sidebar"])
            f.pack(fill="x", pady=5)
            tk.Label(f, text=name, font=("Segoe UI", 10), bg=self.colors["sidebar"], fg=self.colors["text"]).pack(side="left")
            vl = tk.Label(f, text=str(var.get()), font=("Segoe UI", 10, "bold"), bg=self.colors["sidebar"], fg=self.colors["accent"])
            vl.pack(side="right")
            ttk.Scale(f, from_=lo, to=hi, variable=var, orient="horizontal").pack(fill="x")
            var.trace_add("write", lambda *_, v=var, l=vl: (l.config(text=f"{v.get():.2f}" if isinstance(v.get(), float) else str(int(v.get()))), self._save()))
        
        tk.Checkbutton(sf, text="🧠 Chain-of-Thought", variable=self.cot_var, bg=self.colors["sidebar"], 
                      fg=self.colors["text"], selectcolor=self.colors["input_bg"], command=self._save).pack(anchor="w", pady=5)
        
        tk.Frame(sb, bg=self.colors["border"], height=1).pack(fill="x", padx=15, pady=10)
        
        # History
        hf = tk.Frame(sb, bg=self.colors["sidebar"])
        hf.pack(fill="both", expand=True, padx=15)
        tk.Label(hf, text="HISTORY", font=("Segoe UI", 9, "bold"), bg=self.colors["sidebar"], fg=self.colors["text_muted"]).pack(anchor="w")
        
        self.chat_list = tk.Listbox(hf, font=("Segoe UI", 10), bg=self.colors["input_bg"], fg=self.colors["text"],
                                   selectbackground=self.colors["accent"], relief="flat", height=6)
        self.chat_list.pack(fill="both", expand=True, pady=5)
        self.chat_list.bind("<<ListboxSelect>>", self._load_chat)
        self._refresh_chats()
        
        # Bottom
        tk.Label(sb, text="🔒 100% Local", font=("Segoe UI", 9), bg=self.colors["sidebar"], fg=self.colors["success"]).pack(pady=10)
    
    def _build_main(self):
        main = tk.Frame(self, bg=self.colors["bg"])
        main.grid(row=0, column=1, sticky="nsew")
        main.grid_rowconfigure(0, weight=1)
        main.grid_columnconfigure(0, weight=1)
        
        header = tk.Frame(main, bg=self.colors["bg"])
        header.pack(fill="x", padx=20, pady=(15, 5))
        self.title_label = tk.Label(header, text="New Chat", font=("Segoe UI", 16, "bold"), bg=self.colors["bg"], fg=self.colors["text"])
        self.title_label.pack(side="left")
        self.status_label = tk.Label(header, text="Loading...", font=("Segoe UI", 10), bg=self.colors["bg"], fg=self.colors["text_muted"])
        self.status_label.pack(side="right")
        
        cf = tk.Frame(main, bg=self.colors["bg"])
        cf.pack(fill="both", expand=True, padx=20, pady=10)
        self.chat_area = ScrollableChat(cf, self.colors)
        self.chat_area.pack(fill="both", expand=True)
        
        inf = tk.Frame(main, bg=self.colors["bg"])
        inf.pack(fill="x", padx=20, pady=(0, 20))
        ib = tk.Frame(inf, bg=self.colors["input_bg"], padx=15, pady=10)
        ib.pack(fill="x")
        
        self.input_text = tk.Text(ib, font=("Segoe UI", 12), height=3, bg=self.colors["input_bg"], 
                                 fg=self.colors["text"], insertbackground=self.colors["text"], relief="flat", wrap="word")
        self.input_text.pack(side="left", fill="both", expand=True)
        self.input_text.bind("<Return>", self._on_enter)
        
        tk.Button(ib, text="➤", font=("Segoe UI", 18), bg=self.colors["accent"], fg="#1e1e2e",
                 relief="flat", width=3, command=self._send).pack(side="right", padx=(10, 0))
    
    def _load_model(self):
        self.status_label.config(text="Loading...", fg=self.colors["text_muted"])
        def load():
            cfg = MODELS.get(self.selected_model, MODELS[DEFAULT_MODEL])
            self.model = CatSeekR1(cfg)
            self.after(0, self._on_loaded)
        threading.Thread(target=load, daemon=True).start()
    
    def _on_loaded(self):
        c = self.model.config
        self.model_info.config(text=f"Dim:{c.dim} L:{c.n_layers} E:{c.n_experts}")
        self.params_label.config(text=f"{self.model.param_count:,} params")
        self.status_label.config(text="Ready", fg=self.colors["success"])
        self.chat_area.add_message(
            f"Hello! 🐱 I'm **{c.name}** with DeepSeek R1 architecture!\n\n"
            f"• MoE: {c.n_experts} experts (top-{c.n_experts_active})\n"
            f"• MLA: {c.n_heads}/{c.n_kv_heads} heads\n"
            f"• {self.model.param_count:,} parameters\n\n"
            f"100% local & private. Ask me anything, nya~! 💕", False)
    
    def _on_enter(self, e):
        if not (e.state & 0x1): self._send(); return "break"
    
    def _send(self):
        if self.generating or not self.model: return
        text = self.input_text.get("1.0", "end-1c").strip()
        if not text: return
        
        self.input_text.delete("1.0", tk.END)
        self.chat_area.add_message(text, True)
        self.messages.append({"role": "user", "content": text})
        if len(self.messages) == 1: self.title_label.config(text=text[:35])
        
        self.generating = True
        self.status_label.config(text="Generating...", fg=self.colors["accent"])
        
        def gen():
            r = self.model.generate(text, self.max_len_var.get(), self.temp_var.get(), 
                                   self.top_p_var.get(), use_cot=self.cot_var.get())
            self.after(0, lambda: self._on_response(r))
        threading.Thread(target=gen, daemon=True).start()
    
    def _on_response(self, r: str):
        self.chat_area.add_message(r, False)
        self.messages.append({"role": "assistant", "content": r})
        self.status_label.config(text="Ready", fg=self.colors["success"])
        self.generating = False
    
    def _new_chat(self):
        if self.messages:
            self.db.save_chat(self.messages[0]["content"][:25], self.messages)
            self._refresh_chats()
        self.messages = []
        self.chat_area.clear()
        self.title_label.config(text="New Chat")
        if self.model: self.chat_area.add_message("Fresh start! 🐱 What's on your mind?", False)
    
    def _refresh_chats(self):
        self.chat_list.delete(0, tk.END)
        for c in self.db.load_chats()[:12]: self.chat_list.insert(tk.END, f"💬 {c['title'][:22]}")
    
    def _load_chat(self, e):
        sel = self.chat_list.curselection()
        if not sel: return
        chats = self.db.load_chats()
        if sel[0] < len(chats):
            msgs = self.db.load_chat(chats[sel[0]]['id'])
            if msgs:
                self.messages = msgs
                self.chat_area.clear()
                for m in msgs: self.chat_area.add_message(m['content'], m['role'] == 'user')
                self.title_label.config(text=msgs[0]['content'][:35])
    
    def _save(self):
        self.db.set("temp", str(self.temp_var.get()))
        self.db.set("max_len", str(self.max_len_var.get()))
        self.db.set("top_p", str(self.top_p_var.get()))
        self.db.set("cot", "1" if self.cot_var.get() else "0")

