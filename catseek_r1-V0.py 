class CatSeekR1:
    def __init__(self, config: ModelConfig = None):
        self.config = config or MODELS[DEFAULT_MODEL]
        print(f"🐱 Initializing {self.config.name}...")
        
        self.tokenizer = CatSeekTokenizer(self.config.vocab_size)
        self.vocab_size = self.tokenizer.vocab_size
        
        self.embedding = np.random.randn(self.vocab_size, self.config.dim).astype(np.float32) * 0.02
        self.layers = [TransformerBlock(self.config, i) for i in range(self.config.n_layers)]
        self.norm = RMSNorm(self.config.dim)
        self.lm_head = np.random.randn(self.config.dim, self.vocab_size).astype(np.float32) * 0.02
        
        self.param_count = self._count_params()
        self._init_weights()
        self.knowledge = self._build_knowledge()
        print(f"   ✓ {self.param_count:,} parameters ready!")
    
    def _count_params(self) -> int:
        total = self.embedding.size + self.lm_head.size + self.norm.weight.size
        for l in self.layers:
            total += l.attn.W_q.size + l.attn.W_k.size + l.attn.W_v.size + l.attn.W_o.size
            total += l.norm1.weight.size + l.norm2.weight.size
            if l.use_moe:
                total += l.ffn.gate.size
                for e in l.ffn.experts: total += e.W_gate.size + e.W_up.size + e.W_down.size
                total += l.ffn.shared.W_gate.size + l.ffn.shared.W_up.size + l.ffn.shared.W_down.size
            else:
                total += l.ffn.W_gate.size + l.ffn.W_up.size + l.ffn.W_down.size
        return total
    
    def _init_weights(self):
        np.random.seed(42)
        for t in ['I', 'The', 'This', 'Hello', 'Hi', 'Yes', 'Here', 'Let', ' ', '\n', '.', '!', '?']:
            if t in self.tokenizer.token_to_id:
                self.lm_head[:, self.tokenizer.token_to_id[t]] += 0.15
        np.random.seed(None)
    
    def _build_knowledge(self) -> Dict[str, List[str]]:
        return {
            'greeting': [
                f"Hello! 🐱 I'm {self.config.name}, a local AI with DeepSeek R1 architecture. How can I help?",
                f"Hi there! CatSeek R1 here with {self.param_count:,} parameters. What would you like to explore?",
                "Hey! Ready to assist with coding, analysis, or any questions, nya~! 💕",
            ],
            'identity': [f"""I'm **{self.config.name}**, a local AI assistant!

**🏗️ Architecture (DeepSeek R1):**
• MoE: {self.config.n_experts} experts, top-{self.config.n_experts_active}
• MLA: {self.config.n_heads}/{self.config.n_kv_heads} heads (GQA)
• RoPE + RMSNorm + SwiGLU

**📊 Stats:**
• Dim: {self.config.dim} | Layers: {self.config.n_layers}
• Parameters: {self.param_count:,}

🔒 100% local - your data never leaves! nya~! 🐱"""],
            'help': ["""**CatSeek R1** - Your Local AI! 🐱

• 💬 Chat - Natural conversation
• 💻 Code - Write & debug code
• 📝 Write - Essays, emails, stories
• 🧠 Analyze - Problem solving
• 🔒 Private - 100% local

Enable Chain-of-Thought for step-by-step reasoning!"""],
            'thanks': ["You're welcome, nya~! 🐱💕", "Happy to help! 😊", "Anytime!"],
            'goodbye': ["Bye-bye! 🐱👋", "See you later! 💕", "Take care, nya~!"],
        }
    
    def _detect_intent(self, text: str) -> Optional[str]:
        t = text.lower()
        patterns = {
            'greeting': ['hello', 'hi', 'hey', 'greetings'],
            'identity': ['who are you', 'what are you', 'about you', 'your name'],
            'help': ['help', 'what can you do', 'capabilities'],
            'thanks': ['thank', 'thanks', 'thx'],
            'goodbye': ['bye', 'goodbye', 'see you'],
        }
        for intent, kws in patterns.items():
            if any(k in t for k in kws): return intent
        return None
    
    def forward(self, ids: np.ndarray, use_cache: bool = False) -> np.ndarray:
        x = self.embedding[ids]
        for l in self.layers: x = l.forward(x, use_cache)
        return self.norm.forward(x) @ self.lm_head
    
    def generate(self, prompt: str, max_tokens: int = 200, temperature: float = 0.7,
                 top_p: float = 0.9, top_k: int = 50, use_cot: bool = False, **_) -> str:
        # Knowledge base check
        intent = self._detect_intent(prompt)
        if intent and intent in self.knowledge:
            return random.choice(self.knowledge[intent])
        
        # Math
        m = re.search(r'(\d+(?:\.\d+)?)\s*([+\-*/^%])\s*(\d+(?:\.\d+)?)', prompt)
        if m:
            a, op, b = float(m.group(1)), m.group(2), float(m.group(3))
            try:
                r = {'+':a+b, '-':a-b, '*':a*b, '/':a/b if b else float('inf'), '^':a**b, '%':a%b}[op]
                if r == int(r): r = int(r)
                return f"<think>\nCalculating: {a} {op} {b}\n</think>\n\n**{a} {op} {b} = {r}** 🐱"
            except: pass
        
        # Clear cache
        for l in self.layers: l.clear_cache()
        
        # Encode & generate
        tokens = self.tokenizer.encode(prompt)
        ids = np.array([tokens], dtype=np.int32)
        generated = list(tokens)
        
        if len(tokens) > 1:
            _ = self.forward(ids[:, :-1], use_cache=True)
            current = ids[:, -1:]
        else:
            current = ids
        
        for _ in range(max_tokens):
            logits = self.forward(current, use_cache=True)[0, -1] / max(temperature, 0.01)
            
            if top_k > 0:
                mask = np.ones_like(logits, dtype=bool)
                mask[np.argsort(logits)[-top_k:]] = False
                logits[mask] = -1e9
            
            probs = np.exp(logits - logits.max())
            probs = probs / (probs.sum() + 1e-9)
            
            sorted_idx = np.argsort(probs)[::-1]
            cumsum = np.cumsum(probs[sorted_idx])
            keep = sorted_idx[:np.searchsorted(cumsum, top_p) + 1]
            filtered = np.zeros_like(probs)
            filtered[keep] = probs[keep]
            filtered = filtered / (filtered.sum() + 1e-9)
            
            next_tok = np.random.choice(len(filtered), p=filtered)
            generated.append(next_tok)
            
            if next_tok == self.tokenizer.eos_id: break
            if len(generated) > 10 and len(set(generated[-6:])) == 1: break
            
            current = np.array([[next_tok]], dtype=np.int32)
        
        result = self.tokenizer.decode(generated)
        if result.startswith(prompt): result = result[len(prompt):].strip()
        
        if use_cot and len(result) > 5:
            result = "<think>\nLet me think step by step...\n</think>\n\n" + result
        
        return result if len(result) > 3 else "I'd be happy to help! Tell me more? 🐱"
    
    def save(self, path: str):
        with open(path, 'wb') as f:
            pickle.dump({'embedding': self.embedding, 'lm_head': self.lm_head, 
                        'config': self.config.name}, f)
    
    def load(self, path: str):
        with open(path, 'rb') as f:
            d = pickle.load(f)
        self.embedding, self.lm_head = d['embedding'], d['lm_head']

