class RMSNorm:
    def __init__(self, dim: int, eps: float = 1e-6):
        self.eps, self.weight = eps, np.ones(dim, dtype=np.float32)
    
    def forward(self, x: np.ndarray) -> np.ndarray:
        return (x / np.sqrt(np.mean(x**2, axis=-1, keepdims=True) + self.eps)) * self.weight

class RotaryEmbedding:
    def __init__(self, dim: int, max_len: int = 8192, theta: float = 10000.0):
        inv_freq = 1.0 / (theta ** (np.arange(0, dim, 2, dtype=np.float32) / dim))
        t = np.arange(max_len, dtype=np.float32)
        freqs = np.outer(t, inv_freq)
        self.cos, self.sin = np.cos(freqs).astype(np.float32), np.sin(freqs).astype(np.float32)
    
    def apply(self, x: np.ndarray, offset: int = 0) -> np.ndarray:
        seq = x.shape[1]
        cos = self.cos[offset:offset+seq].reshape(1, seq, 1, -1)
        sin = self.sin[offset:offset+seq].reshape(1, seq, 1, -1)
        x1, x2 = x[..., 0::2], x[..., 1::2]
        out = np.zeros_like(x)
        out[..., 0::2] = x1 * cos - x2 * sin
        out[..., 1::2] = x1 * sin + x2 * cos
        return out

class MultiHeadLatentAttention:
    def __init__(self, config: ModelConfig):
        self.dim, self.n_heads, self.n_kv_heads = config.dim, config.n_heads, config.n_kv_heads
        self.head_dim = config.head_dim
        self.n_rep = self.n_heads // self.n_kv_heads
        self.scale = 1.0 / np.sqrt(self.head_dim)
        
        s = lambda i, o: np.random.randn(i, o).astype(np.float32) * np.sqrt(2/(i+o))
        self.W_q = s(config.dim, self.n_heads * self.head_dim)
        self.W_k = s(config.dim, self.n_kv_heads * self.head_dim)
        self.W_v = s(config.dim, self.n_kv_heads * self.head_dim)
        self.W_o = s(self.n_heads * self.head_dim, config.dim)
        self.rope = RotaryEmbedding(self.head_dim, config.max_seq_len, config.rope_theta)
        self.k_cache = self.v_cache = None
    
    def forward(self, x: np.ndarray, use_cache: bool = False) -> np.ndarray:
        b, s, _ = x.shape
        q = (x @ self.W_q).reshape(b, s, self.n_heads, self.head_dim)
        k = (x @ self.W_k).reshape(b, s, self.n_kv_heads, self.head_dim)
        v = (x @ self.W_v).reshape(b, s, self.n_kv_heads, self.head_dim)
        
        offset = 0 if self.k_cache is None else self.k_cache.shape[1]
        q, k = self.rope.apply(q, offset), self.rope.apply(k, offset)
        
        if use_cache:
            if self.k_cache is not None:
                k = np.concatenate([self.k_cache, k], axis=1)
                v = np.concatenate([self.v_cache, v], axis=1)
            self.k_cache, self.v_cache = k, v
        
        k, v = np.repeat(k, self.n_rep, axis=2), np.repeat(v, self.n_rep, axis=2)
        q, k, v = q.transpose(0,2,1,3), k.transpose(0,2,1,3), v.transpose(0,2,1,3)
        
        attn = (q @ k.transpose(0,1,3,2)) * self.scale
        mask = np.triu(np.ones((q.shape[2], k.shape[2])) * -1e9, k=k.shape[2]-q.shape[2]+1)
        attn = np.exp(attn + mask - (attn + mask).max(-1, keepdims=True))
        attn = attn / (attn.sum(-1, keepdims=True) + 1e-9)
        
        return (attn @ v).transpose(0,2,1,3).reshape(b, -1, self.n_heads * self.head_dim) @ self.W_o
    
    def clear_cache(self): self.k_cache = self.v_cache = None

class SwiGLU:
    def __init__(self, dim: int):
        h = ((int(dim * 8/3) + 63) // 64) * 64
        s = lambda i, o: np.random.randn(i, o).astype(np.float32) * np.sqrt(2/(i+o))
        self.W_gate, self.W_up, self.W_down = s(dim, h), s(dim, h), s(h, dim)
    
    def forward(self, x: np.ndarray) -> np.ndarray:
        g = x @ self.W_gate
        g = g * (1 / (1 + np.exp(-np.clip(g, -20, 20))))
        return (g * (x @ self.W_up)) @ self.W_down

class MoELayer:
    def __init__(self, config: ModelConfig):
        self.n_experts, self.n_active = config.n_experts, config.n_experts_active
        self.gate = np.random.randn(config.dim, config.n_experts).astype(np.float32) * 0.02
        self.experts = [SwiGLU(config.dim) for _ in range(config.n_experts)]
        self.shared = SwiGLU(config.dim)
    
    def forward(self, x: np.ndarray) -> np.ndarray:
        b, s, d = x.shape
        x_flat = x.reshape(-1, d)
        
        logits = x_flat @ self.gate
        probs = np.exp(logits - logits.max(-1, keepdims=True))
        probs = probs / (probs.sum(-1, keepdims=True) + 1e-9)
        
        top_k = np.argsort(probs, axis=-1)[:, -self.n_active:]
        weights = np.take_along_axis(probs, top_k, axis=-1)
        weights = weights / (weights.sum(-1, keepdims=True) + 1e-9)
        
        out = np.zeros_like(x_flat)
        for i in range(self.n_active):
            idx, w = top_k[:, i], weights[:, i:i+1]
            for e in range(self.n_experts):
                mask = idx == e
                if mask.any():
                    out[mask] += w[mask] * self.experts[e].forward(x_flat[mask])
        
        return (out + self.shared.forward(x_flat)).reshape(b, s, d)

class TransformerBlock:
    def __init__(self, config: ModelConfig, layer_idx: int):
        self.attn = MultiHeadLatentAttention(config)
        self.use_moe = (layer_idx % 2 == 1)
        self.ffn = MoELayer(config) if self.use_moe else SwiGLU(config.dim)
        self.norm1, self.norm2 = RMSNorm(config.dim), RMSNorm(config.dim)
    
    def forward(self, x: np.ndarray, use_cache: bool = False) -> np.ndarray:
        h = x + self.attn.forward(self.norm1.forward(x), use_cache)
        return h + self.ffn.forward(self.norm2.forward(h))
    
    def clear_cache(self): self.attn.clear_cache()

